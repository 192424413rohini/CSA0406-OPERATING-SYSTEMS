#include <stdio.h>
int main()
{
    int b[10], p[10], nb, np;
    int i, j;
    printf("Enter number of blocks: ");
    scanf("%d",&nb);
    printf("Enter block sizes:\n");
    for(i=0;i<nb;i++)
        scanf("%d",&b[i]);
    printf("Enter number of processes: ");
    scanf("%d",&np);
    printf("Enter process sizes:\n");
    for(i=0;i<np;i++)
        scanf("%d",&p[i]);
    printf("\nProcess\tBlock\n");
    for(i=0;i<np;i++)
    {
        for(j=0;j<nb;j++)
        {
            if(b[j]>=p[i])
            {
                printf("P%d\t%d\n",i+1,j+1);
                b[j]-=p[i];
                break;
            }
        }
        if(j==nb)
            printf("P%d\tNot Allocated\n",i+1);
    }
    return 0;
}
