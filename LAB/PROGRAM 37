#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>
int main() {
    int fd;
    struct stat st;
    DIR *dir;
    struct dirent *entry;
    fd = open("sample.txt", O_RDWR | O_CREAT, 0644);
    printf("File descriptor: %d\n", fd);
    printf("Current position: %ld\n", lseek(fd, 0, SEEK_CUR));
    if (stat("sample.txt", &st) == 0)
        printf("File size: %ld bytes\n", st.st_size);
    dir = opendir(".");
    printf("\nDirectory contents:\n");
    while ((entry = readdir(dir)) != NULL)
        printf("%s\n", entry->d_name);
    close(fd);
    closedir(dir);
    return 0;
}
