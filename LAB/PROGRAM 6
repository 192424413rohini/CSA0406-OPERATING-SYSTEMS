#include <stdio.h>
int main()
{
    int n,i,j,temp;
    int bt[10],p[10];
    printf("Enter number of processes: ");
    scanf("%d",&n);
    printf("Enter Burst Time and Priority:\n");
    for(i=0;i<n;i++)
        scanf("%d%d",&bt[i],&p[i]);
    for(i=0;i<n-1;i++)
        for(j=i+1;j<n;j++)
            if(p[i]>p[j])
            {
                temp=p[i]; p[i]=p[j]; p[j]=temp;
                temp=bt[i]; bt[i]=bt[j]; bt[j]=temp;
            }
    printf("\nProcess\tPriority\tBurst Time\n");
    for(i=0;i<n;i++)
        printf("P%d\t%d\t\t%d\n",i+1,p[i],bt[i]);
    return 0;
}
