#include <stdio.h>
int main()
{
    int alloc[10][10], max[10][10], need[10][10];
    int avail[10], finish[10]={0}, safe[10];
    int p, r, i, j, k=0, flag;
    printf("Enter number of Processes and Resources: ");
    scanf("%d%d",&p,&r);
    printf("Enter Allocation Matrix:\n");
    for(i=0;i<p;i++)
        for(j=0;j<r;j++)
            scanf("%d",&alloc[i][j]);
    printf("Enter Maximum Matrix:\n");
    for(i=0;i<p;i++)
        for(j=0;j<r;j++)
            scanf("%d",&max[i][j]);
    printf("Enter Available Resources:\n");
    for(i=0;i<r;i++)
        scanf("%d",&avail[i]);
    for(i=0;i<p;i++)
        for(j=0;j<r;j++)
            need[i][j]=max[i][j]-alloc[i][j];
    for(int c=0;c<p;c++)
    {
        for(i=0;i<p;i++)
        {
            if(finish[i]==0)
            {
                flag=1;
                for(j=0;j<r;j++)
                    if(need[i][j]>avail[j])
                        flag=0;
                if(flag)
                {
                    safe[k++]=i;
                    finish[i]=1;
                    for(j=0;j<r;j++)
                        avail[j]+=alloc[i][j];
                }
            }
        }
    }
    if(k==p)
    {
        printf("\nSystem is in Safe State\n");
        printf("Safe Sequence: ");
        for(i=0;i<p;i++)
            printf("P%d ",safe[i]);
    }
    else
        printf("\nSystem is NOT in Safe State");
    return 0;
}
