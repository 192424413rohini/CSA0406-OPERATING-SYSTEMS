#include <stdio.h>
int main()
{
    int bt[10], rt[10], n, tq;
    int i, remain, time = 0;
    printf("Enter number of processes: ");
    scanf("%d",&n);
    remain = n;
    printf("Enter Burst Time:\n");
    for(i=0;i<n;i++)
    {
        scanf("%d",&bt[i]);
        rt[i]=bt[i];
    }
    printf("Enter Time Quantum: ");
    scanf("%d",&tq);
    while(remain!=0)
    {
        for(i=0;i<n;i++)
        {
            if(rt[i]>0)
            {
                if(rt[i]<=tq)
                {
                    time += rt[i];
                    rt[i]=0;
                    printf("P%d Completed at %d\n",i+1,time);
                    remain--;
                }
                else
                {
                    rt[i]-=tq;
                    time+=tq;
                }
            }
        }
    }

    return 0;
}
