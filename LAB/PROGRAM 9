#include <stdio.h>
#include <string.h>
#include <sys/ipc.h>
#include <sys/shm.h>
int main()
{
    int shmid;
    char *str;
    shmid = shmget((key_t)1234,1024,0666|IPC_CREAT);
    str = (char *)shmat(shmid,NULL,0);
    printf("Enter Message: ");
    scanf("%s",str);
    printf("Data Written: %s\n",str);
    printf("Data Read: %s\n",str);
    shmdt(str);
    shmctl(shmid,IPC_RMID,NULL);
    return 0;
}
