#include <stdio.h>
int main() {
    FILE *fp;
    char data[100];
    fp = fopen("sample.txt", "w");
    printf("Enter text: ");
    scanf(" %[^\n]", data);
    fprintf(fp, "%s", data);
    fclose(fp);
    fp = fopen("sample.txt", "r");
    printf("\nFile contents: ");
    while (fgets(data, sizeof(data), fp))
        printf("%s", data);
    fclose(fp);
    fp = fopen("sample.txt", "a");
    fprintf(fp, "\nNew data added.");
    fclose(fp);
    printf("\nData appended successfully.");
    return 0;
}
