#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>
#include <unistd.h>
#define N 5
sem_t forks[N];
void *philosopher(void *arg)
{
    int i = *(int *)arg;
    int left = i;
    int right = (i + 1) % N;
    printf("Philosopher %d is thinking\n", i + 1);
    sem_wait(&forks[left]);
    sem_wait(&forks[right]);
    printf("Philosopher %d is eating\n", i + 1);
    sleep(1);
    sem_post(&forks[right]);
    sem_post(&forks[left]);
    printf("Philosopher %d finished eating\n", i + 1);
    return NULL;
}
int main()
{
    pthread_t p[N];
    int id[N];
    for (int i = 0; i < N; i++)
        sem_init(&forks[i], 0, 1);
    for (int i = 0; i < N; i++) {
        id[i] = i;
        pthread_create(&p[i], NULL, philosopher, &id[i]);
    }
    for (int i = 0; i < N; i++)
        pthread_join(p[i], NULL);
    return 0;
}
