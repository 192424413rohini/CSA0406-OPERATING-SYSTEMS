#include <stdio.h>
#include <stdlib.h>
int main() {
    int a[20], n, head, size, total = 0, i, j, temp;
    printf("Enter number of requests: ");
    scanf("%d", &n);
    printf("Enter requests: ");
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);
    printf("Enter head position: ");
    scanf("%d", &head);
    printf("Enter disk size: ");
    scanf("%d", &size);
    for (i = 0; i < n - 1; i++)
        for (j = i + 1; j < n; j++)
            if (a[i] > a[j]) {
                temp = a[i];
                a[i] = a[j];
                a[j] = temp;
            }
    for (i = 0; i < n; i++)
        if (a[i] >= head) {
            total += abs(head - a[i]);
            head = a[i];
        }
    total += abs(head - (size - 1));
    head = size - 1;
    for (i = n - 1; i >= 0; i--)
        if (a[i] < head) {
            total += abs(head - a[i]);
            head = a[i];
        }
    printf("Total head movement = %d\n", total);
    return 0;
}
