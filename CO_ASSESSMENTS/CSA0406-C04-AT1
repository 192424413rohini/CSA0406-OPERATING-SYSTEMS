Q4. C-SCAN and LOOK Disk Scheduling:
  The question requires implementing C-SCAN and LOOK, accepting the request queue, initial head position, and direction, calculating total head movement, displaying seek sequence, and comparing the algorithms.
Aim:
 To implement C-SCAN and LOOK disk scheduling algorithms and compare their total head movement.
Algorithm:
  * Read the number of disk requests and request queue.
  * Read the initial head position.
  * Read the direction of head movement (L or R).
  * Sort the request queue.
  * For C-SCAN, move in the selected direction, service requests, reach the disk end, jump to the opposite end, and continue.
  * For LOOK, move in the selected direction only up to the last requested cylinder, then reverse.
  * Calculate total head movement.
  * Display the seek sequence and total head movement.
  * Compare both algorithms and identify the better algorithm.
C Program:
#include <stdio.h>
#include <stdlib.h>
int main() {
    int n, a[50], head, size, i, j, total;
    char dir;
    printf("Enter number of requests: ");
    scanf("%d", &n);
    printf("Enter request queue: ");
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);
    printf("Enter initial head: ");
    scanf("%d", &head);
    printf("Enter disk size: ");
    scanf("%d", &size);
    printf("Enter direction (L/R): ");
    scanf(" %c", &dir);
    for (i = 0; i < n - 1; i++)
        for (j = i + 1; j < n; j++)
            if (a[i] > a[j]) {
                int t = a[i];
                a[i] = a[j];
                a[j] = t;
            }
    int h = head;
    total = 0;
    printf("\nC-SCAN: %d", h);
    if (dir == 'R' || dir == 'r') {
        for (i = 0; i < n; i++) {
            if (a[i] >= h) {
                total += abs(h - a[i]);
                h = a[i];
                printf(" -> %d", h);
            }
        }
        total += (size - 1 - h);
        h = size - 1;
        total += h;
        h = 0;
        printf(" -> %d -> 0", size - 1);
        for (i = 0; i < n; i++) {
            if (a[i] < head) {
                total += abs(h - a[i]);
                h = a[i];
                printf(" -> %d", h);
            }
        }
    } else {
        for (i = n - 1; i >= 0; i--) {
            if (a[i] <= h) {
                total += abs(h - a[i]);
                h = a[i];
                printf(" -> %d", h);
            }
        }
        total += h;
        h = 0;
        total += size - 1;
        h = size - 1;
        printf(" -> 0 -> %d", size - 1);
        for (i = n - 1; i >= 0; i--) {
            if (a[i] > head) {
                total += abs(h - a[i]);
                h = a[i];
                printf(" -> %d", h);
            }
        }
    }
    printf("\nC-SCAN Total Movement = %d\n", total);
    h = head;
    total = 0;
    printf("\nLOOK: %d", h);
    if (dir == 'R' || dir == 'r') {
        for (i = 0; i < n; i++) {
            if (a[i] >= h) {
                total += abs(h - a[i]);
                h = a[i];
                printf(" -> %d", h);
            }
        }
        for (i = n - 1; i >= 0; i--) {
            if (a[i] < head) {
                total += abs(h - a[i]);
                h = a[i];
                printf(" -> %d", h);
            }
        }
    } else {
        for (i = n - 1; i >= 0; i--) {
            if (a[i] <= h) {
                total += abs(h - a[i]);
                h = a[i];
                printf(" -> %d", h);
            }
        }
        for (i = 0; i < n; i++) {
            if (a[i] > head) {
                total += abs(h - a[i]);
                h = a[i];
                printf(" -> %d", h);
            }
        }
    }
    printf("\nLOOK Total Movement = %d\n", total);
    return 0;
