Q1. File Allocation Methods:
Aim:
  To simulate Contiguous, Linked, and Indexed File Allocation methods.
Algorithm:
  * Read the total number of disk blocks.
  * Read the required file size.
  * Select the allocation method.
  * For Contiguous allocation, find consecutive free blocks.
  * For Linked allocation, allocate any available free blocks.
  * For Indexed allocation, allocate one index block and required data blocks.
  * Display the allocated blocks.
  * Display an error if allocation is not possible.
CODE:
#include <stdio.h>
int main() {
    int n, f, choice, i, j, count;
    int disk[100] = {0};
    printf("Enter total disk blocks: ");
    scanf("%d", &n);
    printf("Enter file size: ");
    scanf("%d", &f);
    printf("Enter method (1-Contiguous 2-Linked 3-Indexed): ");
    scanf("%d", &choice);
    if (f > n) {
        printf("Allocation not possible.\n");
        return 0;
    }
    if (choice == 1) {
        for (i = 0; i <= n - f; i++) {
            count = 0;
            for (j = i; j < i + f; j++) {
                if (disk[j] == 0)
                    count++;
            }
            if (count == f) {
                printf("Allocated blocks: ");
                for (j = i; j < i + f; j++) {
                    disk[j] = 1;
                    printf("%d ", j);
                }
                printf("\n");
                return 0;
            }
        }
        printf("Contiguous allocation failed due to fragmentation.\n");
    }
    else if (choice == 2) {
        count = 0;
        printf("Allocated blocks: ");
        for (i = 0; i < n && count < f; i++) {
            if (disk[i] == 0) {
                disk[i] = 1;
                printf("%d ", i);
                count++;
            }
        }
        if (count < f)
            printf("\nAllocation not possible.\n");
        else
            printf("\n");
    }
    else if (choice == 3) {
        int indexBlock = -1;
        for (i = 0; i < n; i++) {
            if (disk[i] == 0) {
                indexBlock = i;
                disk[i] = 1;
                break;
            }
        }
        if (indexBlock == -1) {
            printf("No index block available.\n");
            return 0;
        }
        count = 0;
        printf("Index block: %d\n", indexBlock);
        printf("Allocated data blocks: ");
        for (i = 0; i < n && count < f; i++) {
            if (disk[i] == 0) {
                disk[i] = 1;
                printf("%d ", i);
                count++;
            }
        }
        if (count < f)
            printf("\nAllocation not possible.\n");
        else
            printf("\n");
    }
    else {
        printf("Invalid allocation method.\n");
    }
    return 0;
}
