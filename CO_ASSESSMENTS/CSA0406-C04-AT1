Q5. Integrated File Allocation and Disk Scheduling:
  The PDF asks to integrate Contiguous/Indexed file allocation with FCFS/SSTF disk scheduling, calculate seek time, compare combinations, avoid duplicate allocation, and identify the best combination.
Aim:
  To integrate file allocation strategies with disk scheduling algorithms and identify the combination with minimum seek time.
Algorithm:
  * Read disk size and file size.
  * Read disk request queue and initial head position.
  * Select allocation method:
        1 → Contiguous
        2 → Indexed
  * Allocate blocks without duplicate allocation.
  * Select scheduling method:
        1 → FCFS
        2 → SSTF
  * Generate the seek sequence for the selected scheduling method.
  * Calculate total seek time.
  * Display allocated blocks, seek sequence, and total seek time.
  * Compare the four combinations:
            Contiguous + FCFS
            Contiguous + SSTF
            Indexed + FCFS
            Indexed + SSTF
  * Display the combination with minimum seek time.
C Program:
#include <stdio.h>
#include <stdlib.h>
int main() {
    int n, f, r, head, choice, sched;
    int i, j, count, total, cur;
    int disk[100], req[50], used[100] = {0};
    printf("Enter disk size: ");
    scanf("%d", &n);
    printf("Enter file size: ");
    scanf("%d", &f);
    printf("Enter number of requests: ");
    scanf("%d", &r);
    printf("Enter request queue: ");
    for (i = 0; i < r; i++)
        scanf("%d", &req[i]);
    printf("Enter initial head: ");
    scanf("%d", &head);
    printf("1. Contiguous  2. Indexed\n");
    scanf("%d", &choice);
    count = 0;
    if (choice == 1) {
        for (i = 0; i <= n - f; i++) {
            count = 0;
            for (j = i; j < i + f; j++)
                if (!used[j])
                    count++;
            if (count == f) {
                printf("Allocated blocks: ");
                for (j = i; j < i + f; j++) {
                    used[j] = 1;
                    printf("%d ", j);
                }
                break;
            }
        }
    } 
    else if (choice == 2) {
        printf("Index block: 0\nAllocated blocks: ");
        used[0] = 1;
        for (i = 1; i < n && count < f; i++) {
            if (!used[i]) {
                used[i] = 1;
                printf("%d ", i);
                count++;
            }
        }
    }
    if (choice == 1 && count != f) {
        printf("\nAllocation failed.\n");
        return 0;
    }
    printf("\n1. FCFS  2. SSTF\n");
    scanf("%d", &sched);
    cur = head;
    total = 0;
    printf("Seek sequence: %d", cur);
    if (sched == 1) {
        for (i = 0; i < r; i++) {
            total += abs(cur - req[i]);
            cur = req[i];
            printf(" -> %d", cur);
        }
    } 
    else if (sched == 2) {
        int visited[50] = {0};
        for (i = 0; i < r; i++) {
            int min = 9999, pos = -1;
            for (j = 0; j < r; j++) {
                if (!visited[j] &&
                    abs(cur - req[j]) < min) {
                    min = abs(cur - req[j]);
                    pos = j;
                }
            }
            visited[pos] = 1;
            total += min;
            cur = req[pos];
            printf(" -> %d", cur);
        }
    }
    printf("\nTotal seek time: %d\n", total);
    return 0;
}
