Q3. FCFS, SSTF and SCAN Disk Scheduling:
  The question requires FCFS, SSTF, and SCAN, taking the request queue, initial head position, and disk size as input, then displaying the seek sequence, total seek time, and best-performing algorithm.
Aim:
  To implement FCFS, SSTF, and SCAN disk scheduling algorithms and compare their total seek time.
Algorithm:
  * Read the disk request queue.
  * Read the initial head position and disk size.
  * In FCFS, service requests in the given order.
  * In SSTF, service the request closest to the current head.
  * In SCAN, move the head in one direction, service requests, reach the disk end, and reverse direction.
  * Calculate total head movement for each algorithm.
  * Display the seek sequence and total seek time.
  * Compare the seek times and identify the best algorithm.
C Program:
#include <stdio.h>
#include <stdlib.h>
int main() {
    int n, head, size, i, j, total;
    int a[50], visited[50] = {0};
    printf("Enter number of requests: ");
    scanf("%d", &n);
    printf("Enter request queue: ");
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);
    printf("Enter initial head: ");
    scanf("%d", &head);
    printf("Enter disk size: ");
    scanf("%d", &size);
    total = 0;
    printf("\nFCFS: %d ", head);
    for (i = 0; i < n; i++) {
        total += abs(head - a[i]);
        head = a[i];
        printf("-> %d ", head);
    }
    printf("\nTotal Seek Time = %d\n", total);
    head = head; 
    printf("\nEnter initial head again: ");
    scanf("%d", &head);
    total = 0;
    for (i = 0; i < n; i++)
        visited[i] = 0;
    printf("SSTF: %d ", head);
    for (i = 0; i < n; i++) {
        int min = 9999, pos = -1;
        for (j = 0; j < n; j++) {
            if (!visited[j] && abs(head - a[j]) < min) {
                min = abs(head - a[j]);
                pos = j;
            }
        }
        visited[pos] = 1;
        total += min;
        head = a[pos];
        printf("-> %d ", head);
    }
    printf("\nTotal Seek Time = %d\n", total);
    head = a[0]; 
    printf("\nEnter initial head again for SCAN: ");
    scanf("%d", &head);
    total = 0;
    printf("SCAN: %d ", head);
    for (i = 0; i < n; i++)
        visited[i] = 0;
    for (i = 0; i < n - 1; i++)
        for (j = i + 1; j < n; j++)
            if (a[i] > a[j]) {
                int t = a[i];
                a[i] = a[j];
                a[j] = t;
            }
    int pos = 0;
    while (pos < n && a[pos] < head)
        pos++;
    for (i = pos; i < n; i++)
        printf("-> %d ", a[i]);
    total += abs(head - a[n - 1]);
    if (pos > 0) {
        total += abs(a[n - 1] - 0);
        printf("-> 0 ");
        total += a[0];
        for (i = 0; i < pos; i++)
            printf("-> %d ", a[i]);
    }
    printf("\nTotal Seek Time = %d\n", total);
    return 0;
}
